APP_ENV=local
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000
DATA_ROOT=../data
MANIFEST_ROOT=../manifests
# HORIZONS_API_URL=https://ssd.jpl.nasa.gov/api/horizons.api

# LLM chat: copy this file to .env in THIS worktree, then add provider keys.
ASSISTANT_ENABLED=false
ASSISTANT_PROVIDER=openai
ASSISTANT_STREAMING=true
ASSISTANT_NATURAL_EXPLANATIONS=true
ASSISTANT_ANSWER_REVIEW=true
ASSISTANT_FAILOVER_ENABLED=false
ASSISTANT_CONNECT_TIMEOUT_SECONDS=15
ASSISTANT_MAX_CONCURRENT_PER_PROVIDER=4
ASSISTANT_RETRY_BASE_SECONDS=60
ASSISTANT_DATABASE_PATH=
NVIDIA_API_KEY=
NVIDIA_MODEL=deepseek-ai/deepseek-v4.1-flash
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MAX_OUTPUT_TOKENS=1048576
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_MAX_OUTPUT_TOKENS=65536
# Path to the immutable NASA/JPL delivery used for metadata indexing and verified imports.
LUNARSIGHT_RAW_DATASET_PATH=

# Generic OpenAI-compatible proxy (select ASSISTANT_PROVIDER=openai).
LLM_PROXY_API_KEY=
LLM_PROXY_BASE_URL=https://ai-proxy.honglinheducation.vn/v1
LLM_PROXY_MODEL=gemini/gemini-3.8-flash
LLM_PROXY_RESPONSE_FORMAT=json_schema
# Lower Gemini thinking for faster structured replies (none|minimal|low|medium|high).
LLM_PROXY_REASONING_EFFORT=low
# Set only after verifying the proxy's per-request output limit.
# LLM_PROXY_MAX_OUTPUT_TOKENS=

# Legacy OpenRouter compatibility for /api/assistant/parse and /evaluate.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_RESPONSE_FORMAT=json_schema
# Optional: omit to let OpenRouter use its default output budget.
# OPENROUTER_MAX_TOKENS=1800
ASSISTANT_DRAFT_TTL_SECONDS=900
ASSISTANT_MAX_DRAFTS=128

# Optional for reasoning models; keep unset to preserve provider defaults.
# OPENROUTER_REASONING_ENABLED=false

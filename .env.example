APP_ENV=local
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000
DATA_ROOT=../data
MANIFEST_ROOT=../manifests
# HORIZONS_API_URL=https://ssd.jpl.nasa.gov/api/horizons.api

# LLM pilot: copy this file to .env in THIS worktree, then fill the two values.
# No model is hardcoded; use an exact OpenRouter model ID.
ASSISTANT_ENABLED=true
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_RESPONSE_FORMAT=json_schema
OPENROUTER_TIMEOUT_SECONDS=30
OPENROUTER_MAX_TOKENS=1800
ASSISTANT_DRAFT_TTL_SECONDS=900
ASSISTANT_MAX_DRAFTS=128

# Optional for reasoning models; keep unset to preserve provider defaults.
# OPENROUTER_REASONING_ENABLED=false

{
  "$defs": {
    "Constraints": {
      "additionalProperties": false,
      "description": "Optional soft preferences; exceeding these never rejects a candidate.",
      "properties": {
        "max_darkness_hours": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Soft preference: maximum continuous darkness, in hours",
          "title": "Max Darkness Hours"
        },
        "max_earth_blackout_hours": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Soft preference: maximum continuous loss of Earth-centre LOS, in hours",
          "title": "Max Earth Blackout Hours"
        }
      },
      "title": "Constraints",
      "type": "object"
    },
    "ContactRequirements": {
      "additionalProperties": false,
      "properties": {
        "min_contact_minutes": {
          "description": "Minimum continuous usable Earth-centre LOS after setup",
          "exclusiveMinimum": 0,
          "title": "Min Contact Minutes",
          "type": "number"
        },
        "setup_minutes": {
          "default": 0.0,
          "minimum": 0,
          "title": "Setup Minutes",
          "type": "number"
        },
        "required_windows": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Number of distinct qualifying visibility windows, not sessions packed into one window",
          "title": "Required Windows"
        },
        "first_contact_deadline_minutes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Minutes since mission start by which setup plus one complete qualifying contact must finish",
          "title": "First Contact Deadline Minutes"
        }
      },
      "required": [
        "min_contact_minutes"
      ],
      "title": "ContactRequirements",
      "type": "object"
    },
    "PointAnalysisRequest": {
      "additionalProperties": false,
      "description": "Compatibility name for the shared mission request.",
      "properties": {
        "site_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Site Id"
        },
        "latitude_deg": {
          "anyOf": [
            {
              "exclusiveMaximum": 90,
              "exclusiveMinimum": -90,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latitude Deg"
        },
        "longitude_e_deg": {
          "anyOf": [
            {
              "maximum": 360,
              "minimum": -180,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Longitude E Deg"
        },
        "start_utc": {
          "description": "Timezone-aware ISO 8601 on an exact 5-minute UTC grid",
          "examples": [
            "2026-11-17T00:00:00Z"
          ],
          "format": "date-time",
          "title": "Start Utc",
          "type": "string"
        },
        "duration_hours": {
          "default": 72.0,
          "description": "At least 1 hour, in 5-minute increments; no application maximum; may be omitted with end_utc",
          "minimum": 1,
          "title": "Duration Hours",
          "type": "number"
        },
        "end_utc": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Alternative UTC end date; must agree with duration_hours if both are supplied",
          "format": "date-time",
          "title": "End Utc"
        },
        "panel_height_m": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "maximum": 20,
          "title": "Panel Height M",
          "type": "number"
        },
        "antenna_height_m": {
          "default": 2.0,
          "exclusiveMinimum": 0,
          "maximum": 20,
          "title": "Antenna Height M",
          "type": "number"
        },
        "constraints": {
          "$ref": "#/$defs/Constraints"
        },
        "min_sunlit_fraction": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Sunlit Fraction"
        },
        "min_earth_los_fraction": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Earth Los Fraction"
        },
        "contact_requirements": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContactRequirements"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "offline": {
          "default": false,
          "title": "Offline",
          "type": "boolean"
        },
        "resolve_indeterminate": {
          "default": false,
          "description": "Complete missing validation, refine horizon at most twice, and check robust sampled mission paths; full-circle warnings and mission thresholds are retained",
          "title": "Resolve Indeterminate",
          "type": "boolean"
        }
      },
      "required": [
        "start_utc"
      ],
      "title": "PointAnalysisRequest",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "result_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Result Id",
      "type": "string"
    },
    "method_version": {
      "title": "Method Version",
      "type": "string"
    },
    "created_utc": {
      "title": "Created Utc",
      "type": "string"
    },
    "execution": {
      "additionalProperties": true,
      "title": "Execution",
      "type": "object"
    },
    "request": {
      "$ref": "#/$defs/PointAnalysisRequest"
    },
    "end_utc": {
      "title": "End Utc",
      "type": "string"
    },
    "coordinate": {
      "additionalProperties": true,
      "title": "Coordinate",
      "type": "object"
    },
    "decision": {
      "anyOf": [
        {
          "enum": [
            "PASS",
            "FAIL",
            "INDETERMINATE"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Decision"
    },
    "nominal_sampled_decision": {
      "anyOf": [
        {
          "enum": [
            "PASS",
            "FAIL",
            "INDETERMINATE"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Nominal Sampled Decision"
    },
    "requirement_policy": {
      "default": "availability-fractions-v1",
      "title": "Requirement Policy",
      "type": "string"
    },
    "constraint_checks": {
      "additionalProperties": {
        "enum": [
          "PASS",
          "FAIL",
          "INDETERMINATE"
        ],
        "type": "string"
      },
      "title": "Constraint Checks",
      "type": "object"
    },
    "soft_constraint_checks": {
      "additionalProperties": {
        "enum": [
          "PASS",
          "FAIL",
          "INDETERMINATE"
        ],
        "type": "string"
      },
      "title": "Soft Constraint Checks",
      "type": "object"
    },
    "soft_violations": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Soft Violations",
      "type": "array"
    },
    "contact_analysis": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Contact Analysis"
    },
    "metrics_hours": {
      "additionalProperties": {
        "items": {
          "type": "number"
        },
        "maxItems": 2,
        "minItems": 2,
        "type": "array"
      },
      "title": "Metrics Hours",
      "type": "object"
    },
    "availability_fraction": {
      "additionalProperties": {
        "items": {
          "type": "number"
        },
        "maxItems": 2,
        "minItems": 2,
        "type": "array"
      },
      "title": "Availability Fraction",
      "type": "object"
    },
    "coverage": {
      "additionalProperties": true,
      "title": "Coverage",
      "type": "object"
    },
    "validation": {
      "additionalProperties": true,
      "title": "Validation",
      "type": "object"
    },
    "timeline": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Timeline",
      "type": "array"
    },
    "events": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Events",
      "type": "array"
    },
    "horizons": {
      "additionalProperties": {
        "items": {
          "additionalProperties": true,
          "type": "object"
        },
        "type": "array"
      },
      "title": "Horizons",
      "type": "object"
    },
    "provenance": {
      "additionalProperties": true,
      "title": "Provenance",
      "type": "object"
    },
    "resolution": {
      "additionalProperties": true,
      "title": "Resolution",
      "type": "object"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "result_id",
    "method_version",
    "created_utc",
    "execution",
    "request",
    "end_utc",
    "coordinate",
    "decision",
    "nominal_sampled_decision",
    "constraint_checks",
    "soft_constraint_checks",
    "metrics_hours",
    "availability_fraction",
    "coverage",
    "validation",
    "timeline",
    "events",
    "horizons",
    "provenance",
    "warnings"
  ],
  "title": "PointAnalysisResult",
  "type": "object"
}
